{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@base/*": [
        "./node_modules/@sellmatch/ui/src/core/base/*"
      ],
      "@shared/*": [
        "./node_modules/@sellmatch/ui/src/shared/*"
      ],
      "@core/*": [
        "./node_modules/@sellmatch/ui/src/core/*"
      ],
      "@routes/*": [
        "./node_modules/@sellmatch/ui/src/routes/*"
      ],
      "src/*": [
        "./node_modules/@sellmatch/ui/src/*"
      ],
      "@views/*": [
        "./src/views-stub/*"
      ],
      "@components/*": [
        "./src/views-stub/components/*"
      ],
      "@app/views/*": [
        "./src/views-stub/*"
      ],
      "@app/*": [
        "./src/views-stub/*"
      ],
      "@env/*": [
        "./node_modules/@sellmatch/ui/src/environments/*"
      ]
    },
    "ignoreDeprecations": "6.0",
    "noImplicitOverride": false
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.d.ts",
    "node_modules/@sellmatch/ui/src/**/*.ts"
  ]
}
